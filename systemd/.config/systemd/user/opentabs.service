[Unit]
Description=OpenTabs MCP server
After=graphical-session.target

[Service]
Type=simple
Environment=PATH=/home/mike/.nvm/versions/node/v26.7.0/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/mike/.nvm/versions/node/v26.7.0/bin/opentabs start
ExecStop=/home/mike/.nvm/versions/node/v26.7.0/bin/opentabs stop
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
