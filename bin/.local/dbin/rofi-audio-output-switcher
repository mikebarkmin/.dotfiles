#!/bin/sh
default_sink=$(pactl get-default-sink)

options=$(pactl -f json list sinks | jq -r --arg default "$default_sink" '
  .[] |
  (.active_port as $ap |
    if $ap == null then true
    else (first(.ports[] | select(.name == $ap)) | .availability) != "not available"
    end
  ) as $usable |
  select($usable) |
  if .name == $default then "● " + .description else "  " + .description end
')

selection=$(echo "$options" | dmenu -i -l 5 -c -p "Output:")
clean_selection=$(echo "$selection" | sed 's/^[● ] *//')

sink_name=$(pactl -f json list sinks | jq -r --arg desc "$clean_selection" '
  .[] | select(.description == $desc) | .name
')

if [ -n "$sink_name" ]; then
    pactl set-default-sink "$sink_name" && notify-send "Audio switched to: $clean_selection"
else
    notify-send "Audio switch failed"
fi
