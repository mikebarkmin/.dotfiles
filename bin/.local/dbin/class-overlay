def timer_status():
    try:
        result = subprocess.run([CLASS_TIMER, "status"], capture_output=True, text=True, check=True)
        return json.loads(result.stdout)
    except (subprocess.CalledProcessError, ValueError):
        return {}


def show_timer(label, status):
    """Shows the time left of the class timer on a label, hides it without timer."""
    zone = status.get("class", "idle")
    left = status.get("left", 0)
    label.set_visible(zone != "idle")
    label.set_label("󰔛  Zeit ist um" if zone == "done" else f"󰔛  {left // 60:02d}:{left % 60:02d}")
    for css_class in TimerPanel.ZONE_COLORS:
        if css_class == zone:
            label.add_css_class(css_class)
        else:
            label.remove_css_class(css_class)


def pid_alive(pidfile):
    try:
        with open(pidfile) as f:
            pid = int(f.read())
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            return b"class-overlay" in f.read() and pid
    except (OSError, ValueError):
        return False


FORMS = {"single": ("󰀄", "Einzelarbeit"), "pair": ("󰀎", "Partnerarbeit"), "group": ("󰡉", "Gruppenarbeit")}
MATERIALS = {"book": ("󱗖", "Buch"), "sheet": ("󰧮", "Arbeitsblatt"), "notebook": ("󰺿", "Heft"),
             "tablet": ("󰓶", "Tablet")}


def read_task():
    try:
        with open(TASK) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write_task(task):
    with open(TASK + ".tmp", "w") as f:
        json.dump(task, f)
    os.replace(TASK + ".tmp", TASK)


def task_form(task):
    icon, name = FORMS.get(task.get("form"), ("", ""))
    return f"{icon}  {name}" if name else ""


def task_lines(task):
    """The task as lines: material with page, task numbers, free text."""
    lines = []
    icon, name = MATERIALS.get(task.get("material"), ("", ""))
    material = f"{icon}  {name}" if name else ""
    if task.get("page"):
        material = f"{material} S. {task['page']}".strip()
    if material:
        lines.append(material)
    if task.get("numbers"):
        lines.append(f"Nr. {task['numbers']}")
    return lines


def prepared_tasks():
    try:
        with open(TASKS_FILE) as f:
            blocks = f.read().split("\n\n")
    except OSError:
        return []
    return [block.strip() for block in blocks if block.strip()]


class TaskPanel:
    KEYS = [list("1234567890") + ["⌫"], list("abcdefgh") + [",", "–", "+"]]
    TIMES = [0, 5, 10, 15, 20, 30]

    def __init__(self, app, box, width):
        self.app = app
        self.task = read_task()
        self.field = "page"
        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self.build_show(width), "show")
        self.stack.add_named(self.build_edit(), "edit")
        self.stack.add_named(self.build_prepared(), "prepared")
        box.append(self.stack)
        if self.task:
            self.show()
        else:
            self.edit()
        GLib.timeout_add(500, self.poll)

    # Showing the task

    def build_show(self, width):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        page.append(Gtk.Label(label="Arbeitsauftrag", css_classes=["title"]))
        self.form_label = Gtk.Label(css_classes=["task-form"])
        page.append(self.form_label)
        self.lines = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        page.append(self.lines)
        self.timer_label = Gtk.Label(css_classes=["time", "task-timer"])
        page.append(self.timer_label)
        buttons = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, margin_top=24)
        buttons.append(action_button("󰲶  Bearbeiten", self.edit))
        self.pin_button = action_button("", self.toggle_pin)
        buttons.append(self.pin_button)
        page.append(buttons)
        page.append(Gtk.Label(label="Daneben tippen zum Schließen", css_classes=["hint"]))
        self.max_chars = int(width / 30)
        return page

    def show(self):
        self.form_label.set_label(task_form(self.task))
        self.form_label.set_visible(bool(self.task.get("form")))
        while child := self.lines.get_first_child():
            self.lines.remove(child)
        for line in task_lines(self.task):
            self.lines.append(Gtk.Label(label=line, css_classes=["task-main"]))
        if self.task.get("text"):
            self.lines.append(Gtk.Label(label=self.task["text"], css_classes=["task-text"], wrap=True,
                                        max_width_chars=self.max_chars, justify=Gtk.Justification.CENTER))
        self.pin_button.set_label("󰤱  Lösen" if pid_alive(PIN_PIDFILE) else "󰤱  Anheften")
        self.stack.set_visible_child_name("show")

    def toggle_pin(self):
        pid = pid_alive(PIN_PIDFILE)
        if pid:
            os.kill(pid, 15)
            self.pin_button.set_label("󰤱  Anheften")
        else:
            subprocess.Popen([CLASS_OVERLAY, "task", "--pinned"], start_new_session=True)
            self.app.quit()

    def poll(self):
        show_timer(self.timer_label, timer_status())
        return True

    # Putting the task together

    def build_edit(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        page.append(Gtk.Label(label="Arbeitsauftrag", css_classes=["title"]))
        grid = Gtk.Grid(column_spacing=16, row_spacing=14, halign=Gtk.Align.CENTER)
        page.append(grid)

        self.form_buttons = self.chips(grid, 0, "Sozialform", [(k, f"{i}  {n}") for k, (i, n) in FORMS.items()],
                                       "form")
        self.material_buttons = self.chips(grid, 1, "Material",
                                           [(k, f"{i}  {n}") for k, (i, n) in MATERIALS.items()], "material")

        fields = Gtk.Box(spacing=12)
        self.field_buttons = {}
        for key, label in (("page", "Seite"), ("numbers", "Nr.")):
            fields.append(Gtk.Label(label=label, css_classes=["field-label"]))
            button = Gtk.Button(css_classes=["small", "field"])
            button.connect("clicked", lambda _b, k=key: self.select_field(k))
            fields.append(button)
            self.field_buttons[key] = button
        grid.attach(Gtk.Label(label="Aufgabe", css_classes=["field-label"], xalign=1), 0, 2, 1, 1)
        grid.attach(fields, 1, 2, 1, 1)

        keypad = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        for row in self.KEYS:
            keys = Gtk.Box(spacing=8)
            for key in row:
                button = Gtk.Button(label=key, css_classes=["small"])
                button.connect("clicked", lambda _b, k=key: self.type(k))
                keys.append(button)
            keypad.append(keys)
        grid.attach(keypad, 1, 3, 1, 1)

        self.time_buttons = self.chips(grid, 4, "Zeit",
                                       [(m, f"{m} min" if m else "ohne") for m in self.TIMES], "minutes")

        self.text_label = Gtk.Label(css_classes=["field-label"], wrap=True, max_width_chars=60)
        page.append(self.text_label)

        buttons = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, margin_top=8)
        self.prepared_button = action_button("󰈙  Vorbereitet", self.choose_prepared)
        buttons.append(self.prepared_button)
        buttons.append(action_button("󰧧  Leeren", self.clear))
        done = Gtk.Button(label="󰄬  Anzeigen", css_classes=["done"])
        done.connect("clicked", lambda _b: self.save())
        buttons.append(done)
        page.append(buttons)
        return page

    def chips(self, grid, row, label, options, key):
        grid.attach(Gtk.Label(label=label, css_classes=["field-label"], xalign=1), 0, row, 1, 1)
        box = Gtk.Box(spacing=8)
        buttons = {}
        for value, text in options:
            button = Gtk.Button(label=text, css_classes=["small"])
            button.connect("clicked", lambda _b, v=value: self.toggle(key, v))
            box.append(button)
            buttons[value] = button
        grid.attach(box, 1, row, 1, 1)
        return buttons

    def toggle(self, key, value):
        # Tapping the selected chip again unselects it.
        self.draft[key] = None if self.draft.get(key) == value and key != "minutes" else value
        self.update_edit()

    def select_field(self, key):
        self.field = key
        self.update_edit()

    def type(self, key):
        value = self.draft.get(self.field) or ""
        self.draft[self.field] = value[:-1] if key == "⌫" else value + key
        self.update_edit()

    def edit(self):
        self.draft = dict(self.task)
        self.draft.setdefault("minutes", 0)
        self.update_edit()
        self.stack.set_visible_child_name("edit")

    def update_edit(self):
        for key, buttons in (("form", self.form_buttons), ("material", self.material_buttons),
                             ("minutes", self.time_buttons)):
            for value, button in buttons.items():
                if self.draft.get(key) == value:
                    button.add_css_class("selected")
                else:
                    button.remove_css_class("selected")
        for key, button in self.field_buttons.items():
            button.set_label(self.draft.get(key) or "–")
            if key == self.field:
                button.add_css_class("active")
            else:
                button.remove_css_class("active")
        self.text_label.set_label(self.draft.get("text") or "")
        self.text_label.set_visible(bool(self.draft.get("text")))
        self.prepared_button.set_visible(bool(prepared_tasks()))

    def clear(self):
        self.draft = {"minutes": 0}
        self.update_edit()

    def save(self):
        task = {key: value for key, value in self.draft.items() if value}
        if not task:
            try:
                os.remove(TASK)
            except OSError:
                pass
            self.app.quit()
            return
        # Starts the timer, unless it already runs for this task.
        minutes = task.get("minutes")
        if minutes and (minutes != self.task.get("minutes") or timer_status().get("class") in ("idle", "done")):
            subprocess.run([CLASS_TIMER, "set", str(minutes)], check=False)
        write_task(task)
        self.task = task
        self.show()

    # Prepared tasks

    def build_prepared(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=20)
        page.append(Gtk.Label(label="Vorbereitete Aufgaben", css_classes=["title"]))
        self.prepared_list = Gtk.Box()
        page.append(self.prepared_list)
        page.append(action_button("Zurück", lambda: self.stack.set_visible_child_name("edit")))
        return page

    def choose_prepared(self):
        tasks = prepared_tasks()
        grid = flowbox(len(tasks))
        for text in tasks:
            label = text.splitlines()[0]
            button = Gtk.Button(label=label if len(label) <= 40 else label[:39] + "…", css_classes=["small"])
            button.connect("clicked", lambda _b, t=text: self.use_prepared(t))
            grid.append(button)
        if child := self.prepared_list.get_first_child():
            self.prepared_list.remove(child)
        self.prepared_list.append(grid)
        self.stack.set_visible_child_name("prepared")

    def use_prepared(self, text):
        self.draft["text"] = text
        self.update_edit()
        self.stack.set_visible_child_name("edit")


def build_pinned(app):
    """The task as a small card in the top right corner, tap it to show it big."""
    win = Gtk.ApplicationWindow(application=app, css_classes=["pinned"])
    LayerShell.init_for_window(win)
    LayerShell.set_namespace(win, "class-task-pin")
    LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
    LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.NONE)
    LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
    LayerShell.set_anchor(win, LayerShell.Edge.RIGHT, True)
    LayerShell.set_margin(win, LayerShell.Edge.TOP, 16)
    LayerShell.set_margin(win, LayerShell.Edge.RIGHT, 16)
    monitor = bar_monitor()
    if monitor:
        LayerShell.set_monitor(win, monitor)

    card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=["pin-card"])
    form = Gtk.Label(css_classes=["pin-form"], xalign=0)
    card.append(form)
    lines = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
    card.append(lines)
    timer = Gtk.Label(css_classes=["time", "pin-timer"], xalign=0)
    card.append(timer)
    win.set_child(card)

    shown = {}

    def poll():
        task = read_task()
        if not task:
            app.quit()
            return False
        if task != shown.get("task"):
            shown["task"] = task
            form.set_label(task_form(task))
            form.set_visible(bool(task.get("form")))
            while child := lines.get_first_child():
                lines.remove(child)
            texts = task_lines(task) + ([task["text"]] if task.get("text") else [])
            for text in texts:
                lines.append(Gtk.Label(label=text, css_classes=["pin-line"], xalign=0, wrap=True,
                                       max_width_chars=32))
        show_timer(timer, timer_status())
        return True

    poll()
    GLib.timeout_add(1000, poll)
    click = Gtk.GestureClick()
    click.connect("released", lambda *_: subprocess.Popen([CLASS_TOOLS, "task"], start_new_session=True))
    win.add_controller(click)
    win.present()


