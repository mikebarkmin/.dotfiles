def load_noise():
    """class-noise as a module, for its paths, thresholds and colour zones."""
    loader = importlib.machinery.SourceFileLoader("class_noise", CLASS_NOISE)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("class_noise", loader))
    loader.exec_module(module)
    return module


def theme_colors():
    """The @define-color values of the theme as (r, g, b) tuples for cairo."""
    colors = {}
    try:
        with open(COLORS) as f:
            for line in f:
                parts = line.split()
                if len(parts) == 3 and parts[0] == "@define-color" and parts[2].startswith("#"):
                    rgb = parts[2].rstrip(";").lstrip("#")
                    colors[parts[1]] = tuple(int(rgb[i:i + 2], 16) / 255 for i in (0, 2, 4))
    except (OSError, ValueError):
        pass
    return colors


class NoisePanel:
    MODES = [("silent", "󰖁  Stillarbeit"), ("whisper", "󰕿  Flüstern"), ("group", "󰕾  Gruppenarbeit"), (None, "󰍭  Aus")]
    LOW, HIGH = -75.0, -5.0  # dBFS shown on the meter
    ZONE_COLORS = {"quiet": "green", "ok": "yellow", "loud": "peach", "too-loud": "red"}

    def __init__(self, app, box, width):
        self.app = app
        self.noise = load_noise()
        self.colors = theme_colors()
        self.mode = self.noise.read_mode()
        self.thresholds = self.noise.read_thresholds()
        self.level = None
        self.calibration = None

        box.append(Gtk.Label(label="Lautstärke", css_classes=["title"]))
        modes = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
        self.mode_buttons = {}
        for mode, label in self.MODES:
            button = Gtk.Button(label=label)
            button.connect("clicked", lambda _b, m=mode: self.set_mode(m))
            modes.append(button)
            self.mode_buttons[mode] = button
        box.append(modes)

        self.meter = Gtk.DrawingArea(content_width=int(width * 0.6), content_height=140, margin_top=24)
        self.meter.set_draw_func(self.draw)
        drag = Gtk.GestureDrag()
        drag.connect("drag-begin", lambda _g, x, _y: self.set_threshold_at(x))
        drag.connect("drag-update", lambda g, dx, _dy: self.set_threshold_at(g.get_start_point()[1] + dx))
        drag.connect("drag-end", lambda *_: self.save())
        self.meter.add_controller(drag)
        box.append(self.meter)
        self.hint = Gtk.Label(css_classes=["hint"])
        box.append(self.hint)

        adjust = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
        self.minus = Gtk.Button(label="−  Strenger", css_classes=["action"])
        self.minus.connect("clicked", lambda _b: self.nudge(-2))
        self.calibrate_button = Gtk.Button(label="󰑓  Einmessen", css_classes=["action"])
        self.calibrate_button.connect("clicked", lambda _b: self.calibrate())
        self.plus = Gtk.Button(label="+  Lockerer", css_classes=["action"])
        self.plus.connect("clicked", lambda _b: self.nudge(2))
        for button in (self.minus, self.calibrate_button, self.plus):
            adjust.append(button)
        box.append(adjust)

        done = Gtk.Button(label="Fertig", css_classes=["done"], halign=Gtk.Align.CENTER, margin_top=16)
        done.connect("clicked", lambda _b: app.quit())
        box.append(done)

        self.update_controls()
        GLib.timeout_add(100, self.poll)

    def update_controls(self):
        for mode, button in self.mode_buttons.items():
            if mode == self.mode:
                button.add_css_class("selected")
            else:
                button.remove_css_class("selected")
        for button in (self.minus, self.calibrate_button, self.plus):
            button.set_sensitive(self.mode is not None and self.calibration is None)
        if self.mode is None:
            self.hint.set_label("Mikrofon aus · Arbeitsform wählen, um zu messen")
        elif self.calibration is not None:
            self.hint.set_label(f"Höre in den Raum … {5 - len(self.calibration) // 10} s")
        else:
            self.hint.set_label("Linie ziehen: ab hier wird es rot · es wird nichts aufgenommen")
        self.meter.queue_draw()

    def set_mode(self, mode):
        self.mode = mode
        if mode is None:
            try:
                os.remove(self.noise.MODE)
            except OSError:
                pass
        else:
            with open(self.noise.MODE, "w") as f:
                f.write(mode + "\n")
        self.calibration = None
        self.update_controls()

    def poll(self):
        try:
            with open(self.noise.LEVEL) as f:
                self.level = float(f.read())
        except (OSError, ValueError):
            self.level = None
        if self.calibration is not None and self.level is not None:
            self.calibration.append(self.level)
            if len(self.calibration) >= 50:
                # A bit above the usual level while the class works as it should.
                levels = sorted(self.calibration)
                self.set_threshold(levels[int(len(levels) * 0.8)] + 4)
                self.save()
                self.calibration = None
            self.update_controls()
        self.meter.queue_draw()
        return True

    def calibrate(self):
        self.calibration = []
        self.update_controls()

    def set_threshold(self, db):
        if self.mode:
            self.thresholds[self.mode] = round(min(max(db, self.LOW + 10), self.HIGH), 1)
            self.meter.queue_draw()

    def set_threshold_at(self, x):
        if self.calibration is None:
            width = self.meter.get_width()
            self.set_threshold(self.LOW + x / width * (self.HIGH - self.LOW))

    def nudge(self, db):
        self.set_threshold(self.thresholds[self.mode] + db)
        self.save()

    def save(self):
        os.makedirs(os.path.dirname(self.noise.THRESHOLDS), exist_ok=True)
        with open(self.noise.THRESHOLDS, "w") as f:
            json.dump(self.thresholds, f, indent=2)

    def color(self, name, alpha=1.0):
        r, g, b = self.colors.get(name, (0.5, 0.5, 0.5))
        return r, g, b, alpha

    def draw(self, _area, cr, width, height):
        def x_of(db):
            return (min(max(db, self.LOW), self.HIGH) - self.LOW) / (self.HIGH - self.LOW) * width

        bar_top, bar_height = 32, height - 72
        if self.mode is None:
            cr.set_source_rgba(*self.color("surface0"))
            cr.rectangle(0, bar_top, width, bar_height)
            cr.fill()
            return

        threshold = self.thresholds[self.mode]
        zones = [("quiet", self.LOW, threshold - 10), ("ok", threshold - 10, threshold - 5),
                 ("loud", threshold - 5, threshold), ("too-loud", threshold, self.HIGH)]
        for zone, start, end in zones:
            # Dim zones as the scale, the live level lights them up.
            color = self.ZONE_COLORS[zone]
            cr.set_source_rgba(*self.color(color, 0.35))
            cr.rectangle(x_of(start), bar_top, x_of(end) - x_of(start), bar_height)
            cr.fill()
            if self.level is not None and self.level > start:
                cr.set_source_rgba(*self.color(color))
                cr.rectangle(x_of(start), bar_top, x_of(min(self.level, end)) - x_of(start), bar_height)
                cr.fill()

        # The threshold: a line with a handle to drag.
        x = x_of(threshold)
        cr.set_source_rgba(*self.color("text"))
        cr.rectangle(x - 3, bar_top - 14, 6, bar_height + 28)
        cr.fill()
        cr.arc(x, bar_top - 14, 18, 0, 2 * math.pi)
        cr.fill()

        layout = self.meter.create_pango_layout("leise")
        layout.set_font_description(Pango.FontDescription.from_string("JetBrainsMono Nerd Font Propo Bold 14"))
        cr.set_source_rgba(*self.color("subtext0"))
        cr.move_to(0, height - 28)
        PangoCairo.show_layout(cr, layout)
        layout.set_text("laut")
        cr.move_to(width - layout.get_pixel_size()[0], height - 28)
        PangoCairo.show_layout(cr, layout)


class TimerPanel:
    PRESETS = [1, 2, 3, 5, 10, 15, 20, 30]
    ZONE_COLORS = {"plenty": "green", "half": "yellow", "low": "peach", "done": "red", "paused": "overlay1"}

    def __init__(self, app, box, width, countdown):
        self.app = app
        self.width = width
        self.countdown = countdown
        self.colors = theme_colors()
        self.status = {}

        if not countdown:
            box.append(Gtk.Label(label="Timer", css_classes=["title"]))
        self.time = Gtk.Label(css_classes=["time"])
        box.append(self.time)
        self.progress = Gtk.DrawingArea(content_width=int(width * (0.8 if countdown else 0.6)),
                                        content_height=48 if countdown else 28)
        self.progress.set_draw_func(self.draw)
        self.progress.set_can_target(False)  # a tap on it closes the countdown
        box.append(self.progress)

        if countdown:
            box.append(Gtk.Label(label="Tippen zum Schließen", css_classes=["hint"]))
        else:
            presets = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, margin_top=24)
            for minutes in self.PRESETS:
                button = Gtk.Button(label=f"{minutes} min")
                button.connect("clicked", lambda _b, m=minutes: self.run("set", str(m)))
                presets.append(button)
            box.append(presets)

            controls = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER)
            for label, args in (("+1 min", ("add", "1")), ("+5 min", ("add", "5"))):
                button = Gtk.Button(label=label, css_classes=["action"])
                button.connect("clicked", lambda _b, a=args: self.run(*a))
                controls.append(button)
            self.pause = Gtk.Button(css_classes=["action"])
            self.pause.connect("clicked", lambda _b: self.run("pause"))
            controls.append(self.pause)
            self.reset = Gtk.Button(label="󰑓  Zurücksetzen", css_classes=["action"])
            self.reset.connect("clicked", lambda _b: self.run("reset"))
            controls.append(self.reset)
            box.append(controls)

            bottom = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, margin_top=16)
            show = Gtk.Button(label="󰊓  Vollbild", css_classes=["action"])
            show.connect("clicked", lambda _b: self.show_countdown())
            bottom.append(show)
            done = Gtk.Button(label="Fertig", css_classes=["done"])
            done.connect("clicked", lambda _b: app.quit())
            bottom.append(done)
            box.append(bottom)

        self.poll()
        GLib.timeout_add(250, self.poll)

    def run(self, *args):
        subprocess.run([CLASS_TIMER, *args], check=False)
        self.poll()

    def show_countdown(self):
        subprocess.Popen([CLASS_OVERLAY, "timer", "--countdown"], start_new_session=True)
        self.app.quit()

    def poll(self):
        try:
            result = subprocess.run([CLASS_TIMER, "status"], capture_output=True, text=True, check=True)
            self.status = json.loads(result.stdout)
        except (subprocess.CalledProcessError, ValueError):
            self.status = {}
        zone = self.status.get("class", "idle")
        left = self.status.get("left", 0)
        text = "Zeit ist um" if zone == "done" else f"{left // 60:02d}:{left % 60:02d}"
        if self.countdown:
            self.time.set_markup(big_markup(text, self.width))
        else:
            self.time.set_markup(f'<span font_size="96pt">{text}</span>')
        for css_class in self.ZONE_COLORS:
            if css_class == zone:
                self.time.add_css_class(css_class)
            else:
                self.time.remove_css_class(css_class)
        if not self.countdown:
            running = zone not in ("idle", "done")
            self.pause.set_label("󰐊  Weiter" if self.status.get("paused") else "󰏤  Pause")
            self.pause.set_sensitive(running)
            self.reset.set_sensitive(zone != "idle")
        self.progress.queue_draw()
        return True

    def draw(self, _area, cr, width, height):
        r, g, b = self.colors.get("surface0", (0.3, 0.3, 0.3))
        cr.set_source_rgb(r, g, b)
        rounded_rect(cr, 0, 0, width, height, height / 2)
        cr.fill()
        total = self.status.get("total", 0)
        if total:
            zone = self.status.get("class")
            r, g, b = self.colors.get(self.ZONE_COLORS.get(zone, "text"), (0.8, 0.8, 0.8))
            cr.set_source_rgb(r, g, b)
            fill = width * self.status.get("left", 0) / total
            if fill > 0:
                rounded_rect(cr, 0, 0, max(fill, height), height, height / 2)
                cr.fill()


class DicePanel:
    SIDES = [6, 10, 20, 100]

    def __init__(self, box, width, sides, remember):
        self.sides = sides
        self.remember = remember

        self.title = Gtk.Label(css_classes=["title"])
        box.append(self.title)
        self.spinner = Spinner(width)
        box.append(self.spinner.label)

        buttons = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, margin_top=24)
        buttons.append(action_button("󰇎  Neu würfeln", self.roll))
        self.side_buttons = {}
        for n in self.SIDES:
            button = Gtk.Button(label=f"1–{n}", css_classes=["action"])
            button.connect("clicked", lambda _b, n=n: self.set_sides(n))
            buttons.append(button)
            self.side_buttons[n] = button
        box.append(buttons)
        box.append(Gtk.Label(label="Daneben tippen zum Schließen", css_classes=["hint"]))

        self.set_sides(sides)

    def set_sides(self, sides):
        self.sides = sides
        self.title.set_label(f"Würfel 1–{sides}")
        for n, button in self.side_buttons.items():
            if n == sides:
                button.add_css_class("selected")
            else:
                button.remove_css_class("selected")
        if self.remember:
            with open(self.remember, "w") as f:
                f.write(f"{sides}\n")
        self.roll()

    def roll(self):
        numbers = [str(n) for n in range(1, self.sides + 1)]
        self.spinner.spin(numbers, random.choice(numbers))


class PickPanel:
    def __init__(self, app, box, width):
        self.title = Gtk.Label(css_classes=["title"])
        box.append(self.title)
        self.spinner = Spinner(width)
        box.append(self.spinner.label)

        buttons = Gtk.Box(spacing=16, halign=Gtk.Align.CENTER, margin_top=24)
        buttons.append(action_button("󰒟  Nächste:r", self.next))
        buttons.append(action_button("󰀎  Klasse wechseln", lambda: run_tool(app, "class", "pick")))
        box.append(buttons)
        box.append(Gtk.Label(label="Daneben tippen zum Schließen", css_classes=["hint"]))
        self.next()

