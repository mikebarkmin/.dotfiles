def rounded_rect(cr, x, y, width, height, radius):
    cr.new_sub_path()
    cr.arc(x + width - radius, y + radius, radius, -math.pi / 2, 0)
    cr.arc(x + width - radius, y + height - radius, radius, 0, math.pi / 2)
    cr.arc(x + radius, y + height - radius, radius, math.pi / 2, math.pi)
    cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
    cr.close_path()


def interactive(widget):
    """Whether a tap on the widget should not close the overlay."""
    while widget:
        if isinstance(widget, (Gtk.Button, Gtk.DrawingArea)):
            return True
        widget = widget.get_parent()
    return False


def build(app, args):
    load_css()
    if args.command == "task" and args.pinned:
        build_pinned(app)
        return
    win = Gtk.ApplicationWindow(application=app)
    LayerShell.init_for_window(win)
    LayerShell.set_namespace(win, "class-overlay")
    LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
    LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
    for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM, LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
        LayerShell.set_anchor(win, edge, True)
    monitor = bar_monitor()
    if monitor:
        LayerShell.set_monitor(win, monitor)
    monitor = monitor or Gdk.Display.get_default().get_monitors()[0]
    width = monitor.get_geometry().width

    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=24, valign=Gtk.Align.CENTER, halign=Gtk.Align.CENTER)
    if args.command == "blank":
        # Covers the bars too, the board should show nothing at all.
        LayerShell.set_exclusive_zone(win, -1)
        win.add_css_class("blank")
    elif args.command == "task":
        TaskPanel(app, box, width)
    elif args.command == "signal":
        SignalPanel(box)
    elif args.command == "pick":
        PickPanel(app, box, width)
    elif args.command == "groups":
        GroupsPanel(app, box, args.choice)
    elif args.command == "dice":
        DicePanel(box, width, args.sides, args.remember)
    elif args.command == "timer":
        TimerPanel(app, box, width, args.countdown)
    elif args.command == "noise":
        NoisePanel(app, box, width)
    elif args.command == "choose":
        box.append(Gtk.Label(label=args.title, css_classes=["title"]))
        grid = flowbox(len(args.options))
        for option in args.options:
            button = Gtk.Button(label=option)
            button.connect("clicked", lambda _b, o=option: choose(app, o))
            grid.append(button)
        box.append(grid)
        box.append(Gtk.Label(label="Daneben tippen zum Abbrechen", css_classes=["hint"]))
    win.set_child(box)

    click = Gtk.GestureClick()
    click.connect("released", lambda _g, _n, x, y: interactive(win.pick(x, y, Gtk.PickFlags.DEFAULT)) or app.quit())
    win.add_controller(click)
    keys = Gtk.EventControllerKey()
    keys.connect("key-pressed", lambda _c, key, *_: key == Gdk.KEY_Escape and app.quit())
    win.add_controller(keys)
    win.present()


def main():
    parser = argparse.ArgumentParser(prog="class-overlay")
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("blank")
    sub.add_parser("noise")
    dice = sub.add_parser("dice")
    dice.add_argument("--sides", type=int, default=6)
    dice.add_argument("--remember")
    timer = sub.add_parser("timer")
    timer.add_argument("--countdown", action="store_true")
    sub.add_parser("pick")
    sub.add_parser("signal")
    task = sub.add_parser("task")
    task.add_argument("--pinned", action="store_true")
    groups = sub.add_parser("groups")
    groups.add_argument("choice")
    choose_parser = sub.add_parser("choose")
    choose_parser.add_argument("title")
    choose_parser.add_argument("options", nargs="+")
    args = parser.parse_args()

    pidfile = PIN_PIDFILE if args.command == "task" and args.pinned else PIDFILE
    with open(pidfile, "w") as f:
        f.write(f"{os.getpid()}\n")

    app = Gtk.Application(application_id="de.mikebarkmin.ClassOverlay", flags=Gio.ApplicationFlags.NON_UNIQUE)
    app.choice = None
    app.connect("activate", build, args)
    GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: app.quit() or False)
    try:
        app.run([])
    finally:
        if pid_alive(pidfile) == os.getpid():
            os.remove(pidfile)
    if args.command == "choose":
        if app.choice is None:
            sys.exit(1)
        print(app.choice)


if __name__ == "__main__":
    main()
