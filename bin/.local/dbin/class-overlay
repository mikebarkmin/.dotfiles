def bar_monitor():
    """The monitor the smartboard bar runs on, None to let the compositor choose."""
    try:
        with open(BAR_CONFIG) as f:
            output = json.load(f)["output"][0]
    except (OSError, ValueError, KeyError, IndexError):
        return None
    for monitor in Gdk.Display.get_default().get_monitors():
        if monitor.get_connector() == output:
            return monitor
    return None


def load_css():
    css = CSS
    try:
        with open(COLORS) as f:
            css = f.read() + css
    except OSError:
        pass
    provider = Gtk.CssProvider()
    provider.load_from_string(css)
    Gtk.StyleContext.add_provider_for_display(
        Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
    )


class Spinner:
    """A huge label that flicks through candidates, slowing down, then lands on a
    result. A new spin stops the animation of the previous one."""

    def __init__(self, width):
        self.width = width
        self.label = Gtk.Label(css_classes=["big"])
        self.spin_id = 0

    def spin(self, candidates, result):
        self.spin_id += 1
        self.label.remove_css_class("final")
        self.step(self.spin_id, candidates, result, 0)

    def step(self, spin_id, candidates, result, step):
        if spin_id != self.spin_id:
            return False
        if step < 18:
            self.label.set_markup(big_markup(random.choice(candidates), self.width))
            GLib.timeout_add(40 + step * step, self.step, spin_id, candidates, result, step + 1)
        else:
            self.label.set_markup(big_markup(result, self.width))
            self.label.add_css_class("final")
        return False


def big_markup(text, width):
    """Markup sized so that `text` fills most of the screen width (monospace font)."""
    px = min(260, width * 0.7 / (max(len(text), 3) * 0.6))
    return f'<span font_size="{int(px * 0.75)}pt">{GLib.markup_escape_text(text)}</span>'


def columns(n):
    """Grid columns for n items: one row up to five, then roughly square-ish."""
    if n <= 5:
        return n
    if n <= 8:
        return math.ceil(n / 2)
    return math.ceil(math.sqrt(n * 1.6))


def flowbox(n):
    return Gtk.FlowBox(
        selection_mode=Gtk.SelectionMode.NONE,
        homogeneous=True,
        column_spacing=20,
        row_spacing=20,
        max_children_per_line=columns(n),
        min_children_per_line=columns(n),
        halign=Gtk.Align.CENTER,
    )


def cards_grid(cards, label):
    grid = flowbox(len(cards))
    for i, names in enumerate(cards, 1):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, css_classes=["card"])
        if label:
            card.append(Gtk.Label(label=f"{label} {i}", css_classes=["card-label"], xalign=0))
        card.append(Gtk.Label(label=names, css_classes=["card-names"], xalign=0))
        grid.append(card)
    return grid


def run_tool(app, *args):
    """Hands over to another class-tools screen."""
    subprocess.Popen([CLASS_TOOLS, *args], start_new_session=True)
    app.quit()


def tool_json(*args):
    result = subprocess.run([CLASS_TOOLS, *args], capture_output=True, text=True, check=True)
    return json.loads(result.stdout)


